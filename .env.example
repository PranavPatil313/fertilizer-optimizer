# Copy to .env locally. Never commit real credentials.
PORT=8000
ENV=development
DEBUG=false

# PostgreSQL (optional for local SQLite fallback)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/fertilizer_db

# Generate unique random values; do not reuse these examples.
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
REFRESH_TOKEN_EXPIRE_DAYS=7
API_KEY=REPLACE_WITH_A_LONG_RANDOM_API_KEY
RATE_LIMIT=60/minute

# Comma-separated allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional integrations
WEATHER_API_KEY=
GEMINI_API_KEY=
ADMIN_EMAILS=

# Frontend configuration. VITE_* values are public in the browser bundle.
VITE_API_URL=http://localhost:8000
VITE_API_KEY=

# ML artifacts
MODEL_VERSION=v1
MODEL_PATH=src/artifact/model.pkl
PREPROCESSOR_PATH=src/artifact/preprocessor.pkl
