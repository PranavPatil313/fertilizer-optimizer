# Frontend configuration
# Copy to .env.local for local development.
# VITE_* values are bundled into browser JavaScript and are PUBLIC.
# Never put private API keys, JWT secrets, database passwords, or other credentials here.

VITE_API_URL=http://localhost:8000
VITE_APP_NAME=Fertilizer Optimizer
VITE_APP_VERSION=1.0.0

# Local development only: this value is sent to the browser and is visible to every user.
# It must match backend API_KEY for routes that require x-api-key.
# Do not treat a VITE_* key as a secret or use a privileged key in a public deployment.
VITE_API_KEY=

# Optional public frontend feature flags
VITE_ENABLE_OFFLINE_MODE=false
VITE_ENABLE_PWA=false
VITE_ENABLE_MOBILE_OPTIMIZATIONS=true

# Optional analytics configuration (public IDs only)
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

PORT=5173
HOST=localhost
